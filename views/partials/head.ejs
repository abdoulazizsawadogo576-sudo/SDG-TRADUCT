<!DOCTYPE html>
<html lang="fr" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const pageTitle = (typeof title !== 'undefined' && title) ? `${title} | ${settings.shop_name}` : `${settings.shop_name} — ${settings.tagline}`;
     const pageDesc = (typeof description !== 'undefined' && description) ? description : (settings.banner_subtitle || settings.tagline);
     const img = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : (settings.banner_image || settings.logo_url || '/img/og-default.png');
     const absImg = /^https?:/.test(img) ? img : baseUrl + img; %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="theme-color" content="#12141a">
  <link rel="canonical" href="<%= baseUrl + currentPath %>">
  <meta property="og:type" content="<%= typeof product !== 'undefined' ? 'product' : 'website' %>">
  <meta property="og:site_name" content="<%= settings.shop_name %>">
  <meta property="og:title" content="<%= (typeof title !== 'undefined' && title) ? title : settings.shop_name %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="<%= absImg %>">
  <meta property="og:url" content="<%= baseUrl + currentPath %>">
  <meta property="og:locale" content="fr_FR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="<%= settings.logo_url || '/img/favicon.svg' %>">
  <link rel="apple-touch-icon" href="<%= settings.logo_url || '/img/apple-touch-icon.png' %>">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="<%= settings.shop_name %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/style.css?v=1">
  <% if (typeof isAdminPage !== 'undefined' && isAdminPage) { %><link rel="stylesheet" href="/css/admin.css?v=1"><meta name="robots" content="noindex"><% } %>
  <script src="/js/app.js?v=1" defer></script>
  <% if (typeof isAdminPage !== 'undefined' && isAdminPage) { %><script src="/js/admin.js?v=1" defer></script><% } %>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<%- include('icons') %>

# Copiez ce fichier en « .env » et adaptez les valeurs.
PORT=3000
NODE_ENV=production
# Adresse publique du site (utilisée dans les liens envoyés sur WhatsApp)
SITE_URL=https://www.votre-domaine.com
# Identifiants du premier compte administrateur (créé au premier démarrage)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangezMoi-MotDePasse-Long
# Chaîne aléatoire longue pour sécuriser les sessions
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire
# Dossier des données (base + photos) — doit être un disque PERSISTANT
DATA_DIR=./data
# Numéro WhatsApp par défaut (modifiable ensuite dans l'admin)
WHATSAPP_NUMBER=22654231847
# Facultatif : base de données en ligne Turso (gratuite) au lieu du fichier local
# DATABASE_URL=libsql://boutique-votrecompte.turso.io
# DATABASE_AUTH_TOKEN=jeton-turso
# Facultatif : stocker les photos sur Cloudinary (offre gratuite)
# CLOUDINARY_URL=cloudinary://CLE_API:SECRET_API@NOM_DU_CLOUD
